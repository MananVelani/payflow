# worker/.env.example — copy to .env for local dev, never commit .env

# Required
COORDINATOR_ADDR=coordinator-1:50051
LOG_SERVICE_ADDR=payment-log:50054
BANK_API_ADDR=http://mock-bank:8090

# Identity
WORKER_ID=worker-local-1
GRPC_PORT=0
METRICS_PORT=9092

# Behaviour
MAX_CONCURRENT_TASKS=5
HEARTBEAT_INTERVAL=2s

# Bank simulation
BANK_FAIL_RATE=0.10
BANK_LATENCY_MIN_MS=50
BANK_LATENCY_MAX_MS=500

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000

# Logging
LOG_LEVEL=info
